/* Mobile */

@media (max-width: 768px) {
  .ht-grid {
    padding-top: 40px;
    padding-bottom: 40px;
  }

    .ht-grid__inner {
        padding-left: 16px;
        padding-right: 16px;
    }
    .ht-grid__heading {
        font-size: 28px;
        margin-bottom: 20px;
    }
    .ht-grid__grid {
        grid-template-columns: repeat(2, 1fr);
        column-gap: 12px;
        row-gap: 12px;
    }
    /* NO FIXED DESKTOP CARD FOR MOBILE - ASPECT RATIO USED INSTEAD TO AVOID RENDERING ISSUES */
    .ht-card {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
    }
    .ht-card__img {
        height: 100%;
        width: 100%;
        objerct-fit: cover;
    }
    .ht-card__trigger {
        top: 50%;
        left: auto;
        right: 10px;
    }
    /* Modal mobile adjustments instead of fixed position and sizes, to avoid rendering issues and allow content to flow naturally */
    .ht-modal__panel {
        width. calc(100% - 32px);
        height: auto;
        max-height: calc(100vh - 40px);
        overflow: auto;
    }
    /*switch from absolute to grid flow on mobile*/
    .ht-modal__content {
        position: relative;
        height: auto;
        padding: 16px;

        display: grid;
        grid-template-columns: 120px 1fr;
        column-gap: 12px;
        row-gap: 10px;
    }
    .ht-modal__img {
        position: static;
        width:120px;
        height: 140px;
        object-fit: cover;
    }
    .ht-modal__title,
    .ht-modal__price,
