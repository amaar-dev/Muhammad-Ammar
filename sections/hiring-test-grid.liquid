{% comment %}
 js for opening and closing the pop-up modal on trigger click, and closing on ESC key.
{% endcomment %}
<script>
(function () {
  const modal = document.getElementById('ht-modal');
  if (!modal) return;

  const imgEl   = modal.querySelector('.ht-modal__img');
  const titleEl = modal.querySelector('.ht-modal__title');
  const priceEl = modal.querySelector('.ht-modal__price');
  const descEl  = modal.querySelector('.ht-modal__desc');

  // IMPORTANT: these must match your HTML exactly (lowercase)
  const colorBlock = modal.querySelector('[data-variant-block="color"]');
  const sizeBlock  = modal.querySelector('[data-variant-block="size"]');

  const colorWrap  = modal.querySelector('[data-variant="color"]');
  const sizeSelect = modal.querySelector('[data-variant="size"]');

  const addBtn  = modal.querySelector('[data-add-to-cart]');
  const errorEl = modal.querySelector('[data-error]');

  let activeProduct = null;
  let selected = {}; // { Size: "M", Color: "Black" }

  function money(cents) {
    return `$${(cents / 100).toFixed(2)}`;
  }

  function openModal() {
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    hideError();
  }

  function showError(msg) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }
  function hideError() {
    if (!errorEl) return;
    errorEl.textContent = '';
    errorEl.hidden = true;
  }

  // product.options is ARRAY OF OBJECTS: [{name, position, values}, ...]
  function getOptionMeta(product, targets) {
    const opts = product.options || [];
    const tset = targets.map(t => t.toLowerCase());
    return opts.find(o => o && o.name && tset.includes(o.name.toLowerCase())) || null;
  }

  function renderColors(product) {
    if (!colorBlock || !colorWrap) return;

    colorWrap.innerHTML = '';
    colorBlock.hidden = true;

    const colorOpt = getOptionMeta(product, ['color', 'colour']);
    if (!colorOpt || !Array.isArray(colorOpt.values) || !colorOpt.values.length) return;

    colorBlock.hidden = false;

    // default
    if (!selected[colorOpt.name]) selected[colorOpt.name] = colorOpt.values[0];

    colorOpt.values.forEach((val) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ht-variant__btn' + (selected[colorOpt.name] === val ? ' is-active' : '');
      btn.textContent = val;
      btn.dataset.value = val;

      btn.addEventListener('click', () => {
        selected[colorOpt.name] = val;
        [...colorWrap.querySelectorAll('.ht-variant__btn')].forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
      });

      colorWrap.appendChild(btn);
    });
  }

  function renderSizes(product) {
    if (!sizeBlock || !sizeSelect) return;

    sizeSelect.innerHTML = '';
    sizeBlock.hidden = true;

    const sizeOpt = getOptionMeta(product, ['size']);
    if (!sizeOpt || !Array.isArray(sizeOpt.values) || !sizeOpt.values.length) return;

    sizeBlock.hidden = false;

    // default
    if (!selected[sizeOpt.name]) selected[sizeOpt.name] = sizeOpt.values[0];

    sizeOpt.values.forEach((val) => {
      const opt = document.createElement('option');
      opt.value = val;
      opt.textContent = val;
      sizeSelect.appendChild(opt);
    });

    sizeSelect.value = selected[sizeOpt.name];
    sizeSelect.onchange = () => {
      selected[sizeOpt.name] = sizeSelect.value;
    };
  }

  function findMatchingVariant(product) {
    // Shopify .js gives variants with option1/option2 AND options:[...]
    const opts = product.options || []; // objects in order
    return (product.variants || []).find(v => {
      for (let i = 0; i < opts.length; i++) {
        const optName = opts[i].name;         // "Size" / "Color"
        const chosen  = selected[optName];
        if (chosen && v.options && v.options[i] !== chosen) return false;
      }
      return true;
    }) || null;
  }

  async function loadProduct(handle) {
    hideError();

    const res = await fetch(`/products/${handle}.js`);
    if (!res.ok) throw new Error(`Product fetch failed (${res.status})`);

    const product = await res.json();
    activeProduct = product;
    selected = {};

    // image
    if (product.featured_image) {
      imgEl.src = product.featured_image;
      imgEl.alt = product.title || '';
      imgEl.style.display = 'block';
    } else {
      imgEl.removeAttribute('src');
      imgEl.alt = '';
      imgEl.style.display = 'none';
    }

    titleEl.textContent = product.title || '';
    descEl.innerHTML = product.description || '';
    priceEl.textContent = money(product.price || 0);

    renderColors(product);
    renderSizes(product);
  }

  async function addToCart() {
    hideError();
    if (!activeProduct) return;

    const variant = findMatchingVariant(activeProduct);
    if (!variant) {
      showError('This combination is unavailable.');
      return;
    }

    addBtn.disabled = true;
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: variant.id, quantity: 1 })
      });
      if (!res.ok) throw new Error('Add to cart failed');

      closeModal();
    } catch (e) {
      showError('Could not add to cart. Please try again.');
    } finally {
      addBtn.disabled = false;
    }
  }

  document.addEventListener('click', async (e) => {
    const trigger = e.target.closest('.ht-card__trigger');
    if (trigger) {
      e.preventDefault();
      e.stopPropagation();
      try {
        await loadProduct(trigger.dataset.productHandle);
        openModal();
      } catch (err) {
        showError('Could not load product.');
      }
      return;
    }

    if (e.target.closest('[data-ht-close]')) {
      closeModal();
      return;
    }

    if (e.target.closest('[data-add-to-cart]')) {
      e.preventDefault();
      addToCart();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });
})();
</script>

