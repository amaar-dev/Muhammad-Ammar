
{% comment %}
  The following section is HTML for SECTION:GRID layout
{% endcomment %}


<section class="ht-grid" aria-label="Product grid">
  <div class="ht-grid__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ht-grid__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ht-grid__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        <article class="ht-card" {{ block.shopify_attributes }}>
          {% if product != blank %}
            <a class="ht-card__link" href="{{ product.url }}">
              {% if product.featured_image %}
                <img
                  class="ht-card__img"
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                />
              {% endif %}
            </a>

            <button
              type="button"
              class="ht-card__trigger"
              aria-label="Open product details"
              data-product-handle="{{ product.handle }}"
            >
              +
            </button>
          {% else %}
            <div class="ht-card__placeholder">Select a product</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% comment %}
    // * End of Grid section *//
    // Styling of grid elements below */
{% endcomment %}

<style>
  .ht-grid__inner{
    padding-left: 51px; /* Figma: 51 from page border */
    padding-right: 51px;
  }

  .ht-grid__heading{
    font-family: Lustria, serif;
    font-weight: 400;
    font-size: 36px;
    line-height: 120%;
    letter-spacing: 0;
    margin: 90px 0 24px; /* top spacing from Figma, adjust if needed */
  }

  .ht-grid__grid{
    display: grid;
    grid-template-columns: repeat(3, 433px);
    gap: 20px; /* Figma separation */
  }

  .ht-card{
    position: relative;
    width: 433px;
    height: 444px;
    border: 1.5px solid #000;
    overflow: hidden;
    background: #fff;
  }

  .ht-card__img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ht-card__trigger{
    position: absolute;
    width: 22px;
    height: 22px;
    top: 238px;   /* Figma */
    left: 256.5px;/* Figma */
    border-radius: 50%;
    background: rgba(248, 248, 248, 0.9);
    border: 1.5px solid #000;
    cursor: pointer;
    display: grid;
    place-items: center;
    line-height: 1;
    padding: 0;
  }

  /* Responsive: stack to 2 then 1 */
  @media (max-width: 1400px){
    .ht-grid__grid{ grid-template-columns: repeat(2, 433px); }
  }
  @media (max-width: 980px){
    .ht-grid__inner{ padding-left: 20px; padding-right: 20px; }
    .ht-grid__grid{ grid-template-columns: 1fr; }
    .ht-card{ width: 100%; max-width: 433px; }
  }
</style>
{% comment %}
    // * End of Grid section *//
    // Styling of grid elements above */
{% endcomment %}

{% schema %}
{
  "name": "Hiring Test - Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Choose product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hiring Test - Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}