    .ht-grid__grid{ grid-template-columns: 1fr; }
    .ht-card{ width: 100%; max-width: 433px; }
  }
</style>
{% comment %}
 js for opening and closing the pop-up modal on trigger click, and closing on ESC key.
{% endcomment %}


<script>
  (function () {
    const modal = document.getElementById('ht-modal');
    if (!modal) return;

    function openModal() {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
    }

    // Open on circle click
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.ht-card__trigger');
      if (trigger) openModal();

      if (e.target.closest('[data-ht-close]')) closeModal();
    });

    // ESC to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });
  })();
</script>

