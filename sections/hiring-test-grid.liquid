/* Grid section styles */
    .ht-grid {
  /* Outer section size + spacing */
  padding-top: 90px;     /* outer section top */
  padding-bottom: 50px;  /* inner section bottom spacing */
}



  .ht-grid__inner {
  /* Gutters: 51 left, ~49.5 right */
  max-width: 1440px;
  margin: 0 auto;
  padding-left: 51px;
  padding-right: 49.5px;
}
  .ht-grid__heading {
  font-family: Lustria, serif;
  font-weight: 400;
  font-size: 36px;
  line-height: 120%;
  letter-spacing: 0;
  margin: 0 0 30px; /* text to inner grid = 30px */
}

  .ht-grid__grid{
    display: grid;
    grid-template-columns: repeat(3, 433px);
    column-gap: 20px; /* Figma separation */
    row-gap:20px;
  }

  .ht-card{
    position: relative;
    width: 433px;
    height: 444px;
    border: 1.5px solid #000;
    overflow: hidden;
    background: #fff;
  }

  .ht-card__img{
