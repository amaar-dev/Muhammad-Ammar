{% comment %}
 js for opening and closing the pop-up modal on trigger click, and closing on ESC key.
{% endcomment %}
<script>
(function () {
  const modal = document.getElementById('ht-modal');
  if (!modal) return;

  const imgEl   = modal.querySelector('.ht-modal__img');
  const titleEl = modal.querySelector('.ht-modal__title');
  const priceEl = modal.querySelector('.ht-modal__price');
  const descEl  = modal.querySelector('.ht-modal__desc');

  // IMPORTANT: lowercase to match your HTML
  const colorBlock = modal.querySelector('[data-variant-block="color"]');
  const sizeBlock  = modal.querySelector('[data-variant-block="size"]');
  const colorWrap  = modal.querySelector('[data-variant="color"]');
  const sizeSelect = modal.querySelector('[data-variant="size"]');

  const addBtn  = modal.querySelector('[data-add-to-cart]');
  const errorEl = modal.querySelector('[data-error]');

  let activeProduct = null;
  let selected = {};           // optionName -> value
  let lastTrigger = null;      // to restore focus when closing

  function showError(msg) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }
  function hideError() {
    if (!errorEl) return;
    errorEl.textContent = '';
    errorEl.hidden = true;
  }

  function money(cents) {
    try {
      return (cents / 100).toLocaleString(undefined, {
        style: 'currency',
        currency: (window.Shopify && Shopify.currency && Shopify.currency.active) ? Shopify.currency.active : 'USD'
      });
    } catch {
      return `$${(cents / 100).toFixed(2)}`;
    }
  }

  function openModal(triggerEl) {
    lastTrigger = triggerEl || lastTrigger;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';

    // focus close button for accessibility
    const closeBtn = modal.querySelector('[data-ht-close]');
    if (closeBtn) closeBtn.focus();
  }

  function closeModal() {
    // restore focus BEFORE hiding to avoid the aria-hidden warning
    if (lastTrigger && typeof lastTrigger.focus === 'function') lastTrigger.focus();

    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    hideError();
  }

  function getOptionName(product, targets) {
    // targets: ["color","colour"] or ["size"]
    const opts = (product.options || []).map(o => String(o));
    for (const t of targets) {
      const tl = t.toLowerCase();
      const exact = opts.find(o => o.toLowerCase() === tl);
      if (exact) return exact;
      const inc = opts.find(o => o.toLowerCase().includes(tl));
      if (inc) return inc;
    }
    return null;
  }

  function setActiveButton(container, value) {
    if (!container) return;
    container.querySelectorAll('.ht-variant__btn').forEach(btn => {
      btn.classList.toggle('is-active', btn.dataset.value === value);
    });
  }

  function renderColors(product) {
    if (!colorBlock || !colorWrap) return;

    colorWrap.innerHTML = '';
    colorBlock.hidden = true;

    const colorName = getOptionName(product, ['color', 'colour']);
    if (!colorName) return;

    const idx = product.options.indexOf(colorName);
    if (idx < 0) return;

    const values = [...new Set((product.variants || [])
      .map(v => v.options && v.options[idx])
      .filter(Boolean)
    )];

    if (!values.length) return;

    colorBlock.hidden = false;

    // default
    selected[colorName] = selected[colorName] || values[0];

    values.forEach(val => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ht-variant__btn';
      btn.textContent = val;
      btn.dataset.value = val;

      btn.addEventListener('click', () => {
        selected[colorName] = val;
        setActiveButton(colorWrap, val);
        // If size availability depends on color later, we can filter; for now just re-render
        renderSizes(product);
      });

      colorWrap.appendChild(btn);
    });

    setActiveButton(colorWrap, selected[colorName]);
  }

  function renderSizes(product) {
    if (!sizeBlock || !sizeSelect) return;

    sizeSelect.innerHTML = '';
    sizeBlock.hidden = true;

    const sizeName = getOptionName(product, ['size']);
    if (!sizeName) return;

    const idx = product.options.indexOf(sizeName);
    if (idx < 0) return;

    const values = [...new Set((product.variants || [])
      .map(v => v.options && v.options[idx])
      .filter(Boolean)
    )];

    if (!values.length) return;

    sizeBlock.hidden = false;

    // default
    selected[sizeName] = selected[sizeName] || values[0];

    values.forEach(val => {
      const opt = document.createElement('option');
      opt.value = val;
      opt.textContent = val;
      sizeSelect.appendChild(opt);
    });

    sizeSelect.value = selected[sizeName];
    sizeSelect.onchange = () => {
      selected[sizeName] = sizeSelect.value;
    };
  }

  function findMatchingVariant(product) {
    const optionNames = product.options || [];
    return (product.variants || []).find(v => {
      if (!v.options) return false;
      for (let i = 0; i < optionNames.length; i++) {
        const optName = optionNames[i];
        const chosen = selected[optName];
        if (chosen && v.options[i] !== chosen) return false;
      }
      return true;
    });
  }

  async function loadProduct(handle) {
    hideError();

    const res = await fetch(`/products/${handle}.js`);
    if (!res.ok) throw new Error(`Product fetch failed (${res.status})`);
    const product = await res.json();

    activeProduct = product;
    selected = {};

    // image
    if (product.featured_image) {
      imgEl.src = product.featured_image;
      imgEl.alt = product.title || '';
      imgEl.style.display = 'block';
    } else {
      imgEl.removeAttribute('src');
      imgEl.alt = '';
      imgEl.style.display = 'none';
    }

    titleEl.textContent = product.title || '';
    descEl.innerHTML = product.description || '';
    priceEl.textContent = money(product.price || 0);

    renderColors(product);
    renderSizes(product);
  }

  async function addToCart() {
    hideError();
    if (!activeProduct) return;

    const variant = findMatchingVariant(activeProduct);
    if (!variant) {
      showError('This combination is unavailable.');
      return;
    }

    if (addBtn) addBtn.disabled = true;

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: variant.id, quantity: 1 })
      });
      if (!res.ok) throw new Error(`Add to cart failed (${res.status})`);
      closeModal();
    } catch (err) {
      console.error(err);
      showError('Could not add to cart. Please try again.');
    } finally {
      if (addBtn) addBtn.disabled = false;
    }
  }

  document.addEventListener('click', async (e) => {
    const trigger = e.target.closest('.ht-card__trigger');
    if (trigger) {
      e.preventDefault();
      e.stopPropagation();

      const handle = trigger.dataset.productHandle;
      try {
        await loadProduct(handle);
        openModal(trigger);
      } catch (err) {
        console.error(err);
        showError('Could not load product.');
      }
      return;
    }

    if (e.target.closest('[data-ht-close]')) {
      closeModal();
      return;
    }

    if (e.target.closest('[data-add-to-cart]')) {
      e.preventDefault();
      addToCart();
      return;
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });
})();
</script>

