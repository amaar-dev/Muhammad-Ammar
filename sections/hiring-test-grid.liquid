
{% comment %}
  The following section is HTML for SECTION:GRID layout
{% endcomment %}


<section class="ht-grid" aria-label="Product grid">
  <div class="ht-grid__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ht-grid__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ht-grid__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        <article class="ht-card" {{ block.shopify_attributes }}>
          {% if product != blank %}
            <a class="ht-card__link" href="{{ product.url }}">
              {% if product.featured_image %}
                <img
                  class="ht-card__img"
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                />
              {% endif %}
            </a>

            <button
              type="button"
              class="ht-card__trigger"
              aria-label="Open product details"
              data-product-handle="{{ product.handle }}"
            >
              +
            </button>

        {% else %}
            <div class="ht-card__placeholder">Select a product</div>
        {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>


<div class="ht-modal" id="ht-modal" aria-hidden="true">
  <div class="ht-modal__overlay" data-ht-close></div>

  <div class="ht-modal__panel" role="dialog" aria-modal="true" aria-labelledby="ht-modal-title">
    <button class="ht-modal__close" type="button" aria-label="Close popup" data-ht-close>
      ✕
    </button>

{%  comment %}
  popup content revealed on trigger click.
{% endcomment %}
   <div class="ht-modal__content">
      <div class="ht-modal__media">
        <div class="ht-modal__media-placeholder"></div>
      </div>

      <div class="ht-modal__info">
        <h3 class="ht-modal__title" id="ht-modal-title">Product name</h3>
        <p class="ht-modal__price">$0.00</p>
        <p class="ht-modal__desc">Product description goes here.</p>

        <div class="ht-modal__variants">
          <div class="ht-variant">
            <span class="ht-variant__label">Color</span>
            <div class="ht-variant__options">
              <button type="button" class="ht-variant__btn is-active">Black</button>
              <button type="button" class="ht-variant__btn">White</button>
            </div>
          </div>

          <div class="ht-variant">
            <span class="ht-variant__label">Size</span>
            <div class="ht-variant__options">
              <button type="button" class="ht-variant__btn is-active">Medium</button>
              <button type="button" class="ht-variant__btn">Large</button>
            </div>
          </div>
        </div>

        <button class="ht-modal__cta" type="button">ADD TO CART</button>
      </div>
    </div>
  </div>
</div>

{% comment %}
    // * End of Grid section *//
    // Styling of grid elements below */
{% endcomment %}

