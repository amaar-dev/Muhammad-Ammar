
{% comment %}
  The following section is HTML for SECTION:GRID layout
{% endcomment %}


<section class="ht-grid" aria-label="Product grid">
  <div class="ht-grid__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ht-grid__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ht-grid__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        <article class="ht-card" {{ block.shopify_attributes }}>
          {% if product != blank %}
            <a class="ht-card__link" href="{{ product.url }}">
              {% if product.featured_image %}
                <img
                  class="ht-card__img"
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                />
              {% endif %}
            </a>

            <button
              type="button"
              class="ht-card__trigger"
              aria-label="Open product details"
              data-product-handle="{{ product.handle }}"
            >
              +
            </button>

        {% else %}
            <div class="ht-card__placeholder">Select a product</div>
        {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% comment %}
    // * End of Grid section *//
    // HTML for pop-up modal below */
{% endcomment %}
<div class="ht-modal" id="ht-modal" aria-hidden="true">
  <div class="ht-modal__overlay" data-ht-close></div>

  <div class="ht-modal__panel" role="dialog" aria-modal="true" aria-labelledby="ht-modal-title">
    <button class="ht-modal__close" type="button" aria-label="Close popup" data-ht-close>
      ✕
    </button>

    <div class="ht-modal__content">
      <img
        class="ht-modal__img"
        alt=""
        width="120"
        height="140"
        loading="lazy"
      >

      <div class="ht-modal__info">
        <h3 class="ht-modal__title" id="ht-modal-title"></h3>
        <p class="ht-modal__price"></p>
        <div class="ht-modal__desc"></div>
        <!-- Variant selectors get injected here -->
        <div class="ht-modal__variants">
          <div class="ht-variant" data-variant-block="color" hidden>
            <span class="ht-variant__label">Color</span>
            <div class="ht-variant__options" data-variant="color"></div>
          </div>

          <!-- Size gets injected here -->
          <div class="ht-variant ht-variant--size" data-variant-block="size" hidden>
            <label class="ht-variant__label" for="ht-size">Size</label>
            <select id="ht-size" class="ht-variant__select" data-variant="size"></select>
          </div>
        </div>

        <button class="ht-modal__cta" type="button" data-add-to-cart>ADD TO CART</button>
        <p class="ht-modal__error" data-error aria-live="polite" hidden></p>
      </div>
    </div>
  </div>
</div>

