{% comment %}
 Hiring Test - Banner section
//* Banner section*//
{% endcomment %}

<section class="ht-banner" style="{% if section.settings.bg_image != blank %}--ht-bg:url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% endif %}">

  <!-- TOP BAR  -->
  <div class="ht-banner__topbar">
    <div class="ht-banner__brand">
      {{ section.settings.brand_text | escape }}
    </div>

    <div class="ht-banner__tagline">
      {{ section.settings.tagline_text | escape }}
    </div>

    {% if section.settings.top_cta_label != blank and section.settings.top_cta_url != blank %}
      <a class="ht-btn ht-btn--yellow" href="{{ section.settings.top_cta_url }}" aria-label="Choose gift">
        <span class="ht-btn__label">{{ section.settings.top_cta_label }}</span>
        <span class="ht-btn__icon" aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  <!-- IMAGE AREA -->
  <div class="ht-banner__imageArea">
    <div class="ht-banner__inner">
      <div class="ht-banner__content">
        <h1 class="ht-banner__title">{{ section.settings.heading | escape }}</h1>

        {% if section.settings.body_text != blank %}
          <p class="ht-banner__desc">{{ section.settings.body_text | escape }}</p>
        {% endif %}

        {% if section.settings.bottom_cta_label != blank and section.settings.bottom_cta_url != blank %}
          <a class="ht-btn ht-btn--black" href="{{ section.settings.bottom_cta_url }}" aria-label="Shop now">
            <span class="ht-btn__label">{{ section.settings.bottom_cta_label }}</span>
            <span class="ht-btn__icon" aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- BOTTOM STRIP -->
  {% if section.settings.strip_text != blank %}
    <div class="ht-banner__strip">
      {{ section.settings.strip_text | escape }}
    </div>
  {% endif %}

</section>  
{%comment %}
  // * End of Banner section *//

// Styling of banner elements below//
{% endcomment %}

<style>
.ht-banner {
  width: 100%;
  height: 878px;              
  background: #F5F5F5;        
  position: relative;
  overflow: hidden;
}
.ht-banner__imageArea {
  height: 780px;
  background-image: var(--ht-bg);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
.ht-banner__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
}

.ht-banner__topbar {
  height: 64px;
  padding: 10px 50px;        
  background: #F5F5F5;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 360px;               
  box-sizing: border-box;
}

.ht-banner__brand {
    justify-self: start;
    color: #111;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.ht-banner__tagline {
    justify-self: center;
    color: #333;
    text-align: center;
    font-size: 14px;
}

.ht-banner__content {
    margin-top: 120px;
    max-width: 520px;
}

.ht-banner__title {
position: absolute;
left: 4.65%;
right: 63.47%;
top: 55.69%;
bottom: 34%;

font-family: 'Jost';
font-style: normal;
font-weight: 500;
font-size: 70px;
line-height: 100%;

display: flex;
align-items: center;

color: #000000;
}

.ht-banner__desc {
position: absolute;
width: 483px;
height: 84px;
left: 4.65%;
right: 63.47%;
bottom: 151px;
vertical-align: middle;

font-family: 'Jost';
font-style: normal;
font-weight: 400;
font-size: 20px;
letter-spacing: 0px;
line-height: 100%;

display: flex;
align-items: center;

color: #000000;
}

.ht-banner__strip {
  height: 34px;               
  background: rgba(214, 210, 201, 0.85);
  color: #2b2b2b;
  text-transform: uppercase;
  border-top: 1px solid rgba(0, 0, 0, 0.10);
  text-align: center;
  font-family: Jost;
  font-weight: 350;
  font-style: normal;
  font-size: 13px;
  letter-spacing: 0px;
  display: flex;
  justify-content: center;


}

{%comment %}
  /* Button Class styles */
{% endcomment %}

.ht-btn {
    display: flex;
    align-items: center;
    gap: 14px;
    position: relative;
    justify-content: center;
    
    padding: 14px 28px;
    font-family: Jost;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-transform: uppercase;
    text-decoration: none;

    overflow: hidden;
    cursor: pointer;
    transition: color 220ms ease, border-color 220ms ease;
    -webkit-user-select: none;
    user-select: none;
    white-space: nowrap;
    border: 2px solid transparent;
    height: 44px;

}

.ht-btn__label,
.ht-btn__icon {
    position: relative;
    z-index: 2;
}
{%comment %}
  /* Animation for button hover*/
{% endcomment %}


.ht-btn::before {
  content: "";
  position: absolute;
  height: 100%;
  transition: width 220ms ease;
  z-index: 1;
  width: 0;
  top: 0;
  left: 0;
}

.ht-btn:hover::before {
    width: 100%;
}

{%comment %}
  /* yellow to black animation */
{% endcomment %}

.ht-btn--yellow {
    justify-self: end;
    color: #111;
    background: #f1d400;
    border-color: #f1d400;
}

.ht-btn--yellow::before {
    background: #111;
}

.ht-btn--yellow:hover {
    color: #f1d400;
    border-color: #111;
}
{%comment %}
  /*Black to yellow animation*/
{% endcomment %}

.ht-btn--black {
    background: #111;
    color: #fff;
    border-color: #111;

    position: absolute;
    bottom: 100px;
    opacity: 1;
    left: 4.65%;

}
.ht-btn--black::before {
    background: #f1d400;
}
.ht-btn--black:hover {
    color: #111;
    border-color: #f1d400;
}

/* mobile css*/
@media (max-width: 480px) { 

    .ht-banner__topbar {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 12px;
        padding: 10px 20px;
    }

    .ht-banner__topbar .ht-btn--yellow {
        display: none;
    }
    .ht-banner {
        height: auto;
    }
    .ht-banner__brand {
        justify-self: center;
        font-size: 14px;
        white-space: nowrap;
        overflow: visible;
    }
    .ht-banner__tagline {
        justify-self: center;
        text-align: center;
        font-size: 12px;
        line-height: 1.2;
        padding: 0 8px;
    }
    .ht-banner__imageArea {
        height: 560px;
        background-position: bottom left;
        transform: rotate(180deg);
        transform-origin: center;
        padding-top: 40px;
    }
    .ht-banner__inner {
        padding: 0 20px;
        align-items: center;
        justify-content: center;
        transform: rotate(180deg);
    }
    .ht-banner__content {
        margin-top: 32px;
        text-align: center;
        max-width: 100%;
        padding: 0 16px;
    }
    .ht-banner__title,
    .ht-banner__desc{
        position: static;
        display: block;
    }
    .ht-banner__title{
        margin: 0 0 16px;
        font-size: 30px;
        font-weight: 500;
        margin-top: 0;
        text-align: center;
        width:100%;

        font-family: Jost;
        font-weight: 500;
        font-style: Medium;
        font-size: 30px;
        line-height: 100%;
        letter-spacing: 0px;
        text-align: center;
        vertical-align: middle;

    }    
    .ht-banner__desc {
        margin: 0 0 16px;
        font-size: 14px;
        margin-top: 10px;
        text-align: center;
        width: 100%;
        padding: 0 16px;
        line-height: 1.4;
        
    }
    .ht-btn--black {
        position: static;
        display: inline-flex;
        margin: 0 auto 5px;
    }

    .ht-btn::before,
    .ht-btn:hover::before,
    .ht-btn:active::before,
    .ht-btn:focus::before {
        content: none !important;
        display: none !important;
        width: 0 !important;
    }
    .ht-btn,
    .ht-btn:hover,
    .ht-btn:active,
    .ht-btn:focus {
        transition: none !important;
    }


}
</style>

{%comment %}
  /* Schema*/

{% endcomment %}

{% schema %}
{
  "name": "Hiring Test - Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Top left Brand text",
      "default": "TISSOT"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Top centerTagline text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_cta_label",
      "label": "Top right button label",
      "default": "Choose Gift"
    },
    {
      "type": "url",
      "id": "top_cta_url",
      "label": "Top button link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Your Ultimate Gift Guide"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Description",
      "default": "Discover joy with our curated gift selection. \nFind the perfect present for every occasion and make moments unforgettable."
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Bottom strip text",
      "default": "FREE SHIPPING ON ORDERS EXCEEDING $100!"
    },
    {
      "type": "text",
      "id": "bottom_cta_label",
      "label": "bottom right button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "bottom_cta_url",
      "label": "Bottom button link"
    }



  ],
  "presets": [
    {
      "name": "Hiring Test - Banner"
    }
  ]
}
{% endschema %}