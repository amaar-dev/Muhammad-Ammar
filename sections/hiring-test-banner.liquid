{% comment %}
 Hiring Test - Banner section

 current requirements:
 ALL text editable in customiser
 Two animated buttons with hover effects
    Background image editable in customiser

//* Banner section*//
{% endcomment %}

<section class="ht-banner">
  <div class="ht-banner__content" style="{%  if section.settings.bg_image != blank %}--ht-bg:url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% endif %}">
  
    <div class="ht-banner-inner">

        <div class="ht-banner__topbar">
            <div class="ht-banner__brand">
                {{ section.settings.brand_text | escape}}
            </div>
            <div class="ht-banner__tagline">
                {{ section.settings.tagline_text | escape}}
            </div>

            {%  if section.settings.top_cta_label != blank and section.settings.top_cta_url != blank %}
                <a class="ht-btn ht-btn--yellow" href="{{ section.settings.top_cta_url}}">
                    <span class="ht-btn__label">{{ section.settings.top_cta_label }}</span>
                    <span class="ht-btn__icon" aria-hidden="true">→</span>
                </a>
            {% endif %}
        </div>
    </div>    
        
        <div class="ht-banner__content">
            <h1 class="ht-banner__title">{{ section.settings.title_text | escape}}</h1>

            {%  if section.settings.body_text != blank %}
                <p class="ht-banner__desc">{{ section.settings.body_text | escape}}</p>
            {% endif %}
         </div>
        
         {%  if section.settings.strip_text != blank %}
            <div class="ht-banner__strip">
                {{ section.settings.strip_text }}
            </div>
         {% endif %}
  </div> 
</section>    
{%comment %}
  // * End of Banner section *//

// Styling of banner elements below//
{% endcomment %}

<style>
.ht-banner {
  background-image: var(--ht-bg);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  background-color: #000; /* fallback */

  position: relative;
  width: 100%;
  min-height: 520px;

  border-top: 1px solid rgba(255, 255, 255, 0.2);
  border-bottom: 1px solid rgba(0, 0, 0, 0.2);
}

.ht-banner__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 20px 0;
}

.ht-banner__topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
}

.ht-banner__brand {
    justify-self: start;
    color: #111;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.ht-banner__tagline {
    justify-self: center;
    color: #333;
    text-align: center;
}

.ht-banner__content {
    margin-top: 120px;
    max-width: 520px;
}

.ht-banner__title {
    font-size: 54px;
    line-height: 1.1;
    color: #111;
    margin: 0 0 14px;
}

.ht-banner__desc {
    font-size: 18px;
    line-height: 1.5;
    color: #333;
    margin: 0 0 24px;
    max-width: 450px;
}

.ht-banner__strip {
    margin-top: 120px;
    background: rgba(214, 210, 201, 0.85);
    color: #2b2b2b;
    padding: 10px 12px;
    font-size: 12px;
    text-align: center;
    width: 100%;
    border-top: 1px solid rgba(0, 0, 0, 0.10);
}

{%comment %}
  /* Button Class styles */
{% endcomment %}

.ht-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    position: relative;
    justify-content: center;
    
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;

    overflow: hidden;
    cursor: pointer;
    transition: color 220ms ease, border-color 220ms ease;
    -webkit-user-select: none;
    user-select: none;
    white-space: nowrap;

}

.ht-btn__label,
.ht-btn__icon {
    position: relative;
    z-index: 2;
}
{%comment %}
  /* Animation for button hover*/
{% endcomment %}


.ht-btn::before {
  content: "";
  position: absolute;
  width: 100%;
  transition: opacity 220ms ease;
  z-index: 1;
}

.ht-btn:hover::before {
    width: 100%;
}

{%comment %}
  /* yellow to black animation */
{% endcomment %}

.ht-btn--yellow {
    justify-self: end;
    color: #111;
    background: #f1d400;
    border-color: #111;
}

.ht-btn--yellow::before {
    background: #111;
}

.ht-btn--yellow:hover {
    color: #f1d400;
    border-color: #111;
}
{%comment %}
  /*Black to yellow animation*/
{% endcomment %}

.ht-btn--black {
    background: #111;
    color: #fff;
    border-color: #111;
}
.ht-btn--black::before {
    background: #f1d400;
}
.ht-btn--black:hover {
    color: #111;
    border-color: #f1d400;
}


</style>

{%comment %}
  /* Schema*/

{% endcomment %}

{% schema %}
{
  "name": "Hiring Test - Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Top left Brand text",
      "default": "TISSOT"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Top centerTagline text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_cta_label",
      "label": "Top right button label",
      "default": "Choose Gift"
    },
    {
      "type": "url",
      "id": "top_cta_url",
      "label": "Top button link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Your Ultimate Gift Guide"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Description",
      "default": "Discover joy with our curated gift selection. \nFind the perfect present for every occasion and make moments unforgettable."
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Bottom strip text",
      "default": "<p>Free shipping on orders over $100</p>"
    },
    {
      "type": "text",
      "id": "bottom_cta_label",
      "label": "bottom right button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "bottom_cta_url",
      "label": "Bottom button link"
    }



  ],
  "presets": [
    {
      "name": "Hiring Test - Banner"
    }
  ]
}
{% endschema %}